set -e
# Prefer the uv-managed interpreter pinned in .python-version; python3 stays
# the fallback for machines without uv.
if command -v uv >/dev/null 2>&1; then
  PY="uv run --no-project python"
else
  PY=python3
fi
pnpm exec lint-staged
pnpm --filter better-charts typecheck
pnpm --filter better-charts dup
cargo test --workspace --offline
pnpm test:e2e
$PY scripts/check_tick_reader.py
$PY scripts/mock_mt5_bridge.py --self-test
$PY scripts/capture_reconcile_snapshot.py --self-test
