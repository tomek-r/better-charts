{
  "tick_fields": [
    "time_ms",
    "bid",
    "ask",
    "last",
    "volume",
    "volume_real",
    "flags"
  ],
  "level_fields": ["price", "buy", "sell"],
  "bar_fields": ["open_ms", "trade_ticks", "levels"],
  "cases": [
    {
      "name": "single buy flag counts one trade",
      "real_volume": false,
      "carry": null,
      "ticks": [[1000, "100.0", "100.2", "100.2", 1, "0", 32]],
      "trade_ticks": 1,
      "carry_after": ["100.2", "buy"],
      "levels": [["100.2", "1", "0"]]
    },
    {
      "name": "single sell flag counts one trade",
      "real_volume": false,
      "carry": null,
      "ticks": [[1000, "100.0", "100.2", "100.0", 3, "0", 64]],
      "trade_ticks": 1,
      "carry_after": ["100", "sell"],
      "levels": [["100", "0", "1"]]
    },
    {
      "name": "both side flags name no side and the quote rule buys",
      "real_volume": false,
      "carry": null,
      "ticks": [[1000, "100.0", "100.2", "100.2", 1, "0", 96]],
      "trade_ticks": 1,
      "carry_after": ["100.2", "buy"],
      "levels": [["100.2", "1", "0"]]
    },
    {
      "name": "quote rule sells below the mid and buys above it",
      "real_volume": false,
      "carry": null,
      "ticks": [
        [1000, "100.0", "100.4", "100.4", 1, "0", 0],
        [1010, "100.0", "100.4", "100.0", 1, "0", 0]
      ],
      "trade_ticks": 2,
      "carry_after": ["100", "sell"],
      "levels": [
        ["100", "0", "1"],
        ["100.4", "1", "0"]
      ]
    },
    {
      "name": "a last at the mid goes to the tick rule and keeps the carry side",
      "real_volume": false,
      "carry": null,
      "ticks": [
        [1000, "100.0", "100.2", "100.1", 1, "0", 0],
        [1010, "100.0", "100.2", "100.1", 1, "0", 0]
      ],
      "trade_ticks": 2,
      "carry_after": ["100.1", "buy"],
      "levels": [["100.1", "2", "0"]]
    },
    {
      "name": "a quote-only tick trades at the mid with one more digit",
      "real_volume": false,
      "carry": null,
      "ticks": [[1000, "100.0", "100.1", "0", 0, "0", 2]],
      "trade_ticks": 1,
      "carry_after": ["100.05", "buy"],
      "levels": [["100.05", "1", "0"]]
    },
    {
      "name": "the tick rule buys up, sells down and keeps the side unchanged",
      "real_volume": false,
      "carry": null,
      "ticks": [
        [1000, "100.0", "0", "0", 1, "0", 4],
        [1010, "100.1", "0", "0", 1, "0", 4],
        [1020, "100.1", "0", "0", 1, "0", 4],
        [1030, "99.9", "0", "0", 1, "0", 4],
        [1040, "99.9", "0", "0", 1, "0", 4]
      ],
      "trade_ticks": 5,
      "carry_after": ["99.9", "sell"],
      "levels": [
        ["99.9", "0", "2"],
        ["100", "1", "0"],
        ["100.1", "2", "0"]
      ]
    },
    {
      "name": "the tick rule with no carry buys",
      "real_volume": false,
      "carry": null,
      "ticks": [[1000, "100.5", "0", "0", 1, "0", 4]],
      "trade_ticks": 1,
      "carry_after": ["100.5", "buy"],
      "levels": [["100.5", "1", "0"]]
    },
    {
      "name": "the carry of the request decides the first trade",
      "real_volume": false,
      "carry": ["100.0", "sell"],
      "ticks": [
        [1000, "100.0", "0", "0", 1, "0", 4],
        [1010, "100.1", "0", "0", 1, "0", 4]
      ],
      "trade_ticks": 2,
      "carry_after": ["100.1", "buy"],
      "levels": [
        ["100", "0", "1"],
        ["100.1", "1", "0"]
      ]
    },
    {
      "name": "tick volume counts bid changes and skips ask-only quotes",
      "real_volume": false,
      "carry": null,
      "ticks": [
        [1000, "100.0", "100.2", "0", 0, "0", 4],
        [1010, "100.0", "100.2", "0", 0, "0", 2]
      ],
      "trade_ticks": 1,
      "carry_after": ["100.1", "buy"],
      "levels": [["100.1", "1", "0"]]
    },
    {
      "name": "real volume weights trades and falls back to volume when it is not above zero",
      "real_volume": true,
      "carry": null,
      "ticks": [
        [1000, "100.0", "100.2", "100.2", 3, "0", 32],
        [1010, "100.0", "100.2", "100.2", 5, "0.25", 32],
        [1020, "100.0", "100.2", "100.0", 2, null, 0],
        [1030, "100.0", "100.2", "100.2", 4, "n/a", 32]
      ],
      "trade_ticks": 4,
      "carry_after": ["100.2", "buy"],
      "levels": [
        ["100", "0", "2"],
        ["100.2", "7.25", "0"]
      ]
    },
    {
      "name": "a tick without a positive price is no trade",
      "real_volume": false,
      "carry": null,
      "ticks": [
        [1000, "0", "0", "0", 1, "0", 6],
        [1010, "99.5", "0", "0", 1, "0", 4]
      ],
      "trade_ticks": 1,
      "carry_after": ["99.5", "buy"],
      "levels": [["99.5", "1", "0"]]
    },
    {
      "name": "a page that counted no trade returns the carry it was given",
      "real_volume": true,
      "carry": ["25001.75", "sell"],
      "ticks": [[1000, "25001.8", "25002.0", "0", 0, "0", 2]],
      "trade_ticks": 0,
      "carry_after": ["25001.75", "sell"],
      "levels": []
    },
    {
      "name": "the first bar's carry does not cross its open into the next bar",
      "real_volume": false,
      "carry": null,
      "first_open_ms": 1000,
      "bar_opens": [2000],
      "ticks": [
        [1010, "100.0", "0", "100.0", 1, "0", 64],
        [2000, "100.0", "0", "0", 1, "0", 4]
      ],
      "trade_ticks": 2,
      "carry_after": ["100", "buy"],
      "levels": [],
      "bars": [
        [1000, 1, [["100", "0", "1"]]],
        [2000, 1, [["100", "1", "0"]]]
      ]
    },
    {
      "name": "a bar that counted no trade is left out of the bars",
      "real_volume": false,
      "carry": null,
      "first_open_ms": 1000,
      "bar_opens": [2000, 3000],
      "ticks": [
        [1010, "100.0", "100.2", "100.2", 1, "0", 32],
        [3010, "100.0", "100.2", "100.0", 1, "0", 64]
      ],
      "trade_ticks": 2,
      "carry_after": ["100", "sell"],
      "levels": [],
      "bars": [
        [1000, 1, [["100.2", "1", "0"]]],
        [3000, 1, [["100", "0", "1"]]]
      ]
    },
    {
      "name": "the request's carry decides only the first bar's first trade",
      "real_volume": false,
      "carry": ["101.0", "buy"],
      "first_open_ms": 1000,
      "bar_opens": [2000],
      "ticks": [
        [1500, "101.0", "0", "0", 1, "0", 4],
        [2500, "99.0", "0", "0", 1, "0", 4]
      ],
      "trade_ticks": 2,
      "carry_after": ["99", "buy"],
      "levels": [],
      "bars": [
        [1000, 1, [["101", "1", "0"]]],
        [2000, 1, [["99", "1", "0"]]]
      ]
    }
  ]
}
