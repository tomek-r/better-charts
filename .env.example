# Copy to .env in the app's user data folder (see README).
# Generate a private token and set the identical value in the EA's InpBridgeToken.
# Release builds reject an empty token. Never commit your real .env file.
MT5_BRIDGE_TOKEN=
MT5_BRIDGE_ADDR=127.0.0.1:8765

# Start MT5 manually. To enable auto-start, configure its installation paths
# as described in README before changing this to 1.
MT5_BACKEND_ENABLED=0

# Optional transfer limit; defaults to 8 MiB.
# MT5_BRIDGE_MAX_FRAME_BYTES=8388608

# Local order submission permission (MT5 and reconciliation gates still apply).
MT5_BRIDGE_TRADING_ENABLED=false
